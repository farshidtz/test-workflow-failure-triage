2026-07-26T19:38:14.4576616Z echo "::group::Determine which phases to run for this job"
2026-07-26T19:38:14.4576915Z for phase in provision test reserve; do
2026-07-26T19:38:14.4577162Z   export KEY="${phase}_data"
2026-07-26T19:38:14.4577446Z   if /snap/bin/yq -e 'has(strenv(KEY))' "${JOB}" > /dev/null 2>&1; then
2026-07-26T19:38:14.4577768Z     echo "${phase}=true" | tee -a "$GITHUB_OUTPUT"
2026-07-26T19:38:14.4578010Z   else
2026-07-26T19:38:14.4578210Z     echo "${phase}=false" | tee -a "$GITHUB_OUTPUT"
2026-07-26T19:38:14.4578448Z   fi
2026-07-26T19:38:14.4578600Z done
2026-07-26T19:38:14.4578771Z echo "::endgroup::"
