2026-07-26T19:38:20.6487335Z echo "::group::Determine which phases to run for this job"
2026-07-26T19:38:20.6487709Z for phase in provision test reserve; do
2026-07-26T19:38:20.6488016Z   export KEY="${phase}_data"
2026-07-26T19:38:20.6488376Z   if /snap/bin/yq -e 'has(strenv(KEY))' "${JOB}" > /dev/null 2>&1; then
2026-07-26T19:38:20.6488785Z     echo "${phase}=true" | tee -a "$GITHUB_OUTPUT"
2026-07-26T19:38:20.6489086Z   else
2026-07-26T19:38:20.6489333Z     echo "${phase}=false" | tee -a "$GITHUB_OUTPUT"
2026-07-26T19:38:20.6489629Z   fi
2026-07-26T19:38:20.6490194Z done
2026-07-26T19:38:20.6490406Z echo "::endgroup::"
