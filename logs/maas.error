2026-07-26T19:38:20.6462150Z     #!/bin/bash -eu
2026-07-26T19:38:20.6462284Z 
2026-07-26T19:38:20.6462594Z     # The outer testflinger action uses groups for logging. Close its existing one, so we can use our own.
